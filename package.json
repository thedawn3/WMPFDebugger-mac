{
  "name": "WMPFDebugger-mac",
  "version": "1.0.0",
  "main": "src/index.js",
  "license": "GPL-2.0-only",
  "author": "evi0s",
  "scripts": {
    "start": "node src/index.js",
    "start:stable": "WMPF_SAFE_MODE=1 node src/index.js",
    "start:compat": "WMPF_SAFE_MODE=1 WMPF_FORCE_LOADSTART_FLAG=1 WMPF_REWRITE_SCENE=1 WMPF_PATCH_CDP_FILTER=1 node src/index.js --force-loadstart-flag",
    "start:full": "WMPF_SAFE_MODE=0 WMPF_FORCE_LOADSTART_FLAG=1 WMPF_REWRITE_SCENE=1 WMPF_PATCH_CDP_FILTER=1 WMPF_PATCH_RESOURCE_CACHE=1 WMPF_ATTACH_ALL=1 node src/index.js --attach-all --force-loadstart-flag",
    "start:guided": "node tools/start_with_doctor.js stable",
    "start:guided:compat": "node tools/start_with_doctor.js compat",
    "start:guided:full": "node tools/start_with_doctor.js full",
    "doctor": "node tools/start_with_doctor.js doctor",
    "probe:basic": "node tools/cdp_probe.js",
    "probe:advanced": "node tools/cdp_advanced_probe.js",
    "probe:live": "node tools/cdp_live_validation.js"
  },
  "dependencies": {
    "frida": "^17.3.2",
    "protobufjs": "^7.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
